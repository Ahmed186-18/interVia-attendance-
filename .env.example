# Pooled PostgreSQL connection URL (Neon, Supabase, Prisma Postgres, etc.).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Direct/unpooled PostgreSQL URL used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="replace-with-at-least-32-random-characters"
CRON_SECRET="replace-with-a-different-long-random-secret"
SEED_ADMIN_NAME="System Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-12-character-password"
SEED_ADMIN_COUNTRY="Palestine"
SEED_ADMIN_TIMEZONE="Asia/Hebron"
# Optional dedicated AES encryption secret for credentials saved from the admin dashboard.
# If omitted, JWT_SECRET is used as the encryption source.
INTEGRATION_ENCRYPTION_KEY=""
NEXT_PUBLIC_APP_NAME="InterVia Design"

# Dropbox Developer App (OAuth refresh-token flow)
# Required scopes:
# file_requests.read, file_requests.write, files.metadata.read,
# files.content.read, files.content.write
# Required for Dropbox Team Space discovery: account_info.read
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""
DROPBOX_REFRESH_TOKEN=""
# Required when the credentials above represent an entire Dropbox Business team.
DROPBOX_TEAM_MEMBER_ID=""

# Optional for short local tests only. Prefer the refresh-token fields above.
DROPBOX_ACCESS_TOKEN=""
